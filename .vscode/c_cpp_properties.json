{
    "version": 4,
    "env": {
        "appInclude": [
            "${workspaceFolder}/inc/**",
            "${workspaceFolder}/tmp/**",
            "${workspaceFolder}/src/**",
    },
    "configurations": [
        {
            "name": "linux",
            "configurationProvider": "ms-vscode.cmake-tools",
            "mergeConfigurations"  :  true,
            "includePath"          : ["${appInclude}", "${crossInclude}"],
            "defines"              : ["PC", "I5", "X86_64", "LINUX"],
            "compilerPath"         : "/usr/bin/x86_64-linux-gnu-g++",
            "cStandard"            : "c17",
            "cppStandard"          : "c++17",
            "intelliSenseMode"     : "gcc-x64"
        }
    ]
}
